APP_NAME=url-shortener
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener
REDIS_URL=redis://localhost:6379/0

ID_COUNTER_OFFSET=1000000000
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=60
CACHE_LOCK_SECONDS=5

RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_REDIRECT_PER_MIN=300

IP_HASH_SALT=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000

CORS_ORIGINS=["http://localhost:3000"]

WORKER_BATCH_SIZE=500
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_CONSUMER_NAME=click-worker
CLICK_STREAM_KEY=clicks
CLICK_STREAM_GROUP=clicks-group

IDEMPOTENCY_TTL_SECONDS=86400
